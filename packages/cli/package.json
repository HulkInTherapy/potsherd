{
  "name": "slopie",
  "version": "1.7.5",
  "description": "Slopie: inspect retained coding-agent history with a terminal audit and sourced local memory.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/HulkInTherapy/slopie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HulkInTherapy/slopie.git"
  },
  "bugs": "https://github.com/HulkInTherapy/slopie/issues",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "session",
    "history",
    "transcript",
    "memory",
    "search",
    "archive",
    "cli",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "slopie": "bin/slopie.js",
    "potsherd": "bin/potsherd.js"
  },
  "files": [
    "bin",
    "dist/potsherd.js",
    "dist/potsherd.js.map",
    "dist/audit-native-worker.js",
    "dist/audit-native-worker.js.map",
    "README.md",
    "LICENSE",
    "NOTICE",
    "licenses"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/package-readme.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@potsherd/bridges": "workspace:*",
    "@potsherd/core": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "commander": "^12.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.238",
    "@anthropic-ai/sdk": "^0.120.0",
    "@huggingface/transformers": "^4.2.0",
    "sqlite-vec": "^0.1.9"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    }
  }
}
